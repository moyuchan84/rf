# [Conductor] Airtight Dockerfile for rfgo-embedding-worker
FROM harbor.foundrymtc.samsungds.net/library/python:3.12

ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV http_proxy=$HTTP_PROXY
ENV https_proxy=$HTTPS_PROXY

# Internal Registry Settings
ENV PIP_TRUSTED_HOST=pypi.org pypi.python.org files.pythonhosted.org nexus.internal.com harbor.foundrymtc.samsungds.net
ENV PYTHONHTTPSVERIFY=0

WORKDIR /app

# Configure internal pip index
RUN pip config set global.index-url https://nexus.internal.com/repository/pypi-all/simple

# Copy dependency files
COPY pyproject.toml ./
# If uv.lock is needed for pip, it's usually not used directly by pip unless using a wrapper.
# We install dependencies defined in pyproject.toml
RUN pip install --no-cache-dir . || pip install --no-cache-dir faststream[redis] openai pgvector psycopg2-binary pydantic-settings python-dotenv sqlalchemy

COPY . .

# Clean up proxy env for runtime
ENV http_proxy=""
ENV https_proxy=""

# Worker has no external ports
CMD ["python", "main.py"]
